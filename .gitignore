.DS_Store
/Manifest.toml
/Manifest-v*.toml
docs/build/
docs/Manifest.toml
docs/Manifest-v*.toml

# Coverage and allocation output from `Pkg.test(coverage=true)` and `--track-allocation`.
*.cov
*.mem
*.jl.*.cov

# LaTeX intermediates. Rendered documents are deliberate, committed outputs and stay
# tracked: vignettes/*/*.{html,md,pdf}, vignettes/*/*_files/ and docs/src/tutorials/**.
# vignettes/_pandoc/header.tex is a hand-written preamble, not an intermediate.
*.tex
*.aux
*.log
*.out
*.toc
!vignettes/_pandoc/header.tex

# The Python environment of validation/ (see validation/README.md).
validation/.venv/
validation/__pycache__/

# The environment of the gated influence-diagram bridge tests is resolved on demand.
test/influence_diagrams/Manifest.toml
test/influence_diagrams/Manifest-v*.toml
